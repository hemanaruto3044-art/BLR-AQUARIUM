{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Aquarium Product",
      "description": "Fish or equipment available for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "stock": { "type": "integer" },
        "images": { "type": "array", "items": { "type": "string" } },
        "isLiveEnabled": { "type": "boolean" },
        "isFreeDelivery": { "type": "boolean" },
        "deliveryCharge": { "type": "number" },
        "youtubeVideo": { "type": "string" },
        "averageRating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Purchase records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "phone": { "type": "string" },
        "shippingAddress": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "city": { "type": "string" },
            "zip": { "type": "string" }
          }
        },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["cod", "qr"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "pending_verification", "paid"] },
        "trackingId": { "type": "string" },
        "adminAlerted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "Payment": {
      "title": "QR Payment Request",
      "description": "Manual verification records for QR payments",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "qrCodeUrl": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "adminAlerted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "userId", "transactionId", "amount", "status"]
    },
    "LiveCall": {
      "title": "Live View Request",
      "description": "Real-time request for live video of a product",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "ongoing", "accepted", "rejected", "ended"] },
        "adminAlerted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "status"]
    },
    "Giveaway": {
      "title": "Prize Draw",
      "description": "Community giveaways and contests",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "prize": { "type": "string" },
        "entries": { "type": "array", "items": { "type": "string" } },
        "winner": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "prize", "status"]
    },
    "Category": {
      "title": "Product Category",
      "description": "Groups of products (e.g., Fish, Equipment)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "TestRequest": {
      "title": "Test Notification",
      "description": "User test requests to verify admin notification system",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId"]
    },
    "AppSetting": {
      "title": "Global Setting",
      "description": "Configuration for application-wide features",
      "type": "object",
      "properties": {
        "testButtonEnabled": { "type": "boolean" },
        "qrPaymentEnabled": { "type": "boolean" },
        "codPaymentEnabled": { "type": "boolean" }
      }
    },
    "WishlistItem": {
      "title": "Wishlist Item",
      "description": "Products saved by users for later",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId"]
    },
    "FCMToken": {
      "title": "FCM Device Token",
      "description": "Used for push notifications",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "email": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["token", "userId"]
    },
    "Review": {
      "title": "Product Review",
      "description": "Customer ratings and feedback for products",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "comment"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "products": {
      "schema": "Product",
      "description": "Catalog of aquarium products"
    },
    "categories": {
      "schema": "Category",
      "description": "Product categorization"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer purchase history"
    },
    "live_calls": {
      "schema": "LiveCall",
      "description": "Requests for live product demonstrations"
    },
    "giveaways": {
      "schema": "Giveaway",
      "description": "Community contest data"
    },
    "test_requests": {
      "schema": "TestRequest",
      "description": "User testing notifications for admin"
    },
    "settings": {
      "schema": "AppSetting",
      "description": "Application configuration"
    },
    "wishlist": {
      "schema": "WishlistItem",
      "description": "User's saved products"
    },
    "payments": {
      "schema": "Payment",
      "description": "Manual payment verification records"
    },
    "fcm_tokens": {
      "schema": "FCMToken",
      "description": "Admin device tokens for multi-device notifications"
    },
    "reviews": {
      "schema": "Review",
      "description": "Customer product ratings and reviews"
    }
  }
}
